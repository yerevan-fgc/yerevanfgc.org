---
import Link from '../components/Link.astro';
import { getCollection } from 'astro:content';
import { site, locales, localePath, type Locale } from '../config/site';
import { ui } from '../i18n/ui';
import '../styles/global.css';
import { backgroundStorageKey } from '../lib/backgrounds';
interface Props { locale: Locale; title: string; description: string; eventSchema?: Record<string, unknown> }
const { locale, title, description, eventSchema } = Astro.props;
const published = site.published[locale];
const twitterUsername = site.twitterUrl ? new URL(site.twitterUrl).pathname.split('/').filter(Boolean)[0] : undefined;
const backgroundLinks = (await getCollection('backgrounds')).map(entry => entry.data.link);
if (!backgroundLinks.includes(site.defaultBackground)) throw new Error('Default background is missing from the backgrounds collection.');
const canonical = new URL(localePath(locale), site.url).href;
const analyticsId = import.meta.env.PROD && site.analytics.enabled && site.analytics.measurementId;
if (analyticsId && !/^G-[A-Z0-9]+$/.test(analyticsId)) throw new Error('Invalid Google Analytics measurement ID.');
---
<!doctype html>
<html lang={locale} style={`--background-image: url(${JSON.stringify(site.defaultBackground)})`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ backgroundLinks, backgroundStorageKey }}>
      // Restore before styles paint. Ignore removed choices and unavailable storage.
      try {
        const saved = localStorage.getItem(backgroundStorageKey);
        if (backgroundLinks.includes(saved)) document.documentElement.style.setProperty('--background-image', `url(${JSON.stringify(saved)})`);
      } catch {}
    </script>
    <meta name="theme-color" content="#0c0d11" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={published ? 'index, follow' : 'noindex, follow'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {published && locales.filter(l => site.published[l]).map(l => <link rel="alternate" hreflang={l} href={new URL(localePath(l), site.url).href} />)}
    {published && site.published.en && <link rel="alternate" hreflang="x-default" href={new URL('/', site.url).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {twitterUsername && <meta name="twitter:site" content={`@${twitterUsername}`} />}
    <link rel="stylesheet" href="/fonts/fonts.css" />
    {published && eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema).replace(/</g, '\\u003c')} />}
    {published && analyticsId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>}
    {published && analyticsId && <script is:inline define:vars={{ analyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date()); gtag('config', analyticsId);
    </script>}
  </head>
  <body id="top">
    <Link class="skip-link" href="#main">{ui[locale].skip}</Link>
    <slot />
  </body>
</html>
